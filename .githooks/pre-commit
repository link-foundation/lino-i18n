#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/check-file-line-limits.py
(cd js && npm run lint:secrets)
staged_paths=$(git diff --cached --name-only)
if rg -q '^js/' <<< "$staged_paths"; then
  (cd js && npm run check && npm run test:types)
fi
if rg -q '^rust/' <<< "$staged_paths"; then
  cargo fmt --manifest-path rust/Cargo.toml --all -- --check
  cargo clippy --locked --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings
fi
