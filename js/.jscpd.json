{
  "threshold": 10,
  "minTokens": 30,
  "minLines": 5,
  "mode": "weak",
  "ignore": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/*.min.js",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/.changeset/**",
    "**/docs/case-studies/**/data/**",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/.next/**"
  ],
  "format": ["javascript", "typescript", "bash"],
  "reporters": ["console", "html"],
  "output": "./reports/jscpd"
}
