{
  "name": "lino-i18n",
  "version": "0.3.0",
  "description": "Universal i18n library that stores translations in Links Notation (.lino) instead of JSON.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "lino-i18n": "bin/lino-i18n.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./converters": "./src/converters/index.js",
    "./loaders": "./src/loaders.js",
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    }
  },
  "scripts": {
    "test": "node --throw-deprecation --test --test-timeout=30000 tests/*.test.js",
    "test:browser": "playwright test",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd --fail-on-empty .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "pack:dry-run": "npm pack --dry-run",
    "lint:secrets": "secretlint \"bin/**\" \"src/**\" \"scripts/**\" \"tests/**\" \"../scripts/**\" \"../rust/scripts/**\" \"../rust/lino-i18n/src/**\" \"../rust/lino-i18n/tests/**\" \"../rust/lino-i18n-macros/src/**\" \"../.github/**\" \"../.githooks/**\""
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "links-notation",
    "lino",
    "localization"
  ],
  "author": "Link Foundation",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/lino-i18n.git"
  },
  "homepage": "https://github.com/link-foundation/lino-i18n#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/lino-i18n/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "dependencies": {
    "links-notation": "^0.23.0",
    "lino-arguments": "^0.3.0",
    "lino-objects-codec": "^0.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "secretlint": "^13.0.7",
    "test-anywhere": "^0.9.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
