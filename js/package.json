{
  "name": "lino-i18n",
  "version": "0.3.0",
  "description": "Universal i18n library that stores translations in Links Notation (.lino) instead of JSON.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "lino-i18n": "bin/lino-i18n.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./converters": "./src/converters/index.js",
    "./loaders": "./src/loaders.js",
    "./browser": {
      "types": "./src/browser.d.ts",
      "import": "./src/browser.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "import": "./src/react.js"
    },
    "./messages": {
      "types": "./src/messages.d.ts",
      "import": "./src/messages.js"
    },
    "./intl": {
      "types": "./src/intl.d.ts",
      "import": "./src/intl.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js"
    },
    "./react-server": {
      "types": "./src/react-server.d.ts",
      "import": "./src/react-server.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "import": "./src/node.js"
    },
    "./tooling": {
      "types": "./src/tooling.d.ts",
      "import": "./src/tooling.js"
    },
    "./compiler": {
      "types": "./src/compiler.d.ts",
      "import": "./src/compiler.js"
    },
    "./providers/gt": {
      "types": "./src/providers/gt.d.ts",
      "import": "./src/providers/gt.js"
    },
    "./next/server": {
      "types": "./src/next/server.d.ts",
      "import": "./src/next/server.js"
    },
    "./next/client": {
      "types": "./src/next/client.d.ts",
      "import": "./src/next/client.js"
    },
    "./next/proxy": {
      "types": "./src/next/proxy.d.ts",
      "import": "./src/next/proxy.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "import": "./src/vue.js"
    },
    "./vue/extract": {
      "types": "./src/vue-extract.d.ts",
      "import": "./src/vue-extract.js"
    }
  },
  "scripts": {
    "test": "node --throw-deprecation --test --test-timeout=30000 tests/*.test.js",
    "test:browser": "playwright test",
    "test:types": "tsc --project tests/types/tsconfig.json && tsc --project tests/types/tsconfig.next.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd --fail-on-empty .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "pack:dry-run": "npm pack --dry-run",
    "lint:secrets": "secretlint \"bin/**\" \"src/**\" \"scripts/**\" \"tests/**\" \"../scripts/**\" \"../rust/scripts/**\" \"../rust/lino-i18n/src/**\" \"../rust/lino-i18n/tests/**\" \"../rust/lino-i18n-macros/src/**\" \"../.github/**\" \"../.githooks/**\"",
    "test:next": "playwright test --config playwright-next.config.js",
    "build:next": "next build examples/next-usage --webpack"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "translation",
    "links-notation",
    "lino",
    "localization"
  ],
  "author": "Link Foundation",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/lino-i18n.git"
  },
  "homepage": "https://github.com/link-foundation/lino-i18n#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/lino-i18n/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "intl-messageformat": "^12.1.3",
    "links-notation": "^0.23.0",
    "lino-arguments": "^0.3.0",
    "lino-objects-codec": "^0.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/server-renderer": "3.5.43",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "generaltranslation": "9.5.5",
    "jscpd": "^5.4.0",
    "jsdom": "^30.1.2",
    "next": "16.4.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.2",
    "secretlint": "^13.0.7",
    "test-anywhere": "^0.9.1",
    "typescript": "^7.0.2",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "generaltranslation": ">=9.5.5 <10",
    "next": ">=16 <17",
    "react": ">=18.0.0",
    "vue": ">=3.5 <4",
    "@vue/compiler-sfc": ">=3.5 <4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "generaltranslation": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@vue/compiler-sfc": {
      "optional": true
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
